@using System.Globalization
@inject IStringLocalizer<App> L

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentCulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @* Entrance-animation gate. This synchronous inline script runs before first paint and
       before the render-blocking stylesheets below, so `html.preload` is in effect when the
       hero's hidden start state is computed — no flash-of-visible-then-hidden. JS removes it
       after the first paint (see site-interop.js) to trigger the one-shot fade-in. It lives on
       <html>, which is outside the interactive <Routes> island, so Blazor never reconciles it.
       No-JS never adds it, so the resting state (visible) is what ships — fails safe. *@
    <script>document.documentElement.classList.add('preload');</script>
    <meta name="description" content="@L["Meta_Description"]" />
    <meta name="theme-color" content="#0d1117" />

    <!-- OpenGraph -->
    <meta property="og:title" content="@L["Og_Title"]" />
    <meta property="og:description" content="@L["Og_Description"]" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sharpts.dev" />
    <meta property="og:image" content="/img/sharpts-logo.png" />
    <meta property="og:locale" content="@SupportedCultures.OpenGraphLocale(CultureInfo.CurrentCulture.Name)" />

    <title>@L["Meta_Title"]</title>

    <!-- SEO: per-language alternates -->
    @foreach (var culture in SupportedCultures.All)
    {
        <link rel="alternate" hreflang="@culture"
              href="@(culture == SupportedCultures.Default ? "https://sharpts.dev/" : $"https://sharpts.dev/{culture}")" />
    }
    <link rel="alternate" hreflang="x-default" href="https://sharpts.dev/" />

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="any" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Prism.js for static syntax highlighting -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" rel="stylesheet" />

    <!-- App styles -->
    <link href="css/theme.css" rel="stylesheet" />
    <link href="css/app.css" rel="stylesheet" />
    <link href="SharpTS.Www.Web.styles.css" rel="stylesheet" />

    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: true)" />
</head>
<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: true)" />

    <!-- Prism.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-typescript.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-csharp.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-bash.min.js"></script>

    <!-- App scripts -->
    <script src="js/site-interop.js"></script>

    <script src="_framework/blazor.web.js"></script>
</body>
</html>
