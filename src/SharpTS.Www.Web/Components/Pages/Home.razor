@page "/{culture?}"
@inject IStringLocalizer<App> L
@inject NavigationManager Nav

<PageTitle>@L["Meta_Title"]</PageTitle>

<main class="landing">
    <HeroSection />
    <div id="features">
        <FeaturesGrid />
    </div>
    <div id="examples">
        <LiveCodeExamples />
    </div>
    <div id="architecture">
        <ArchitecturePreview />
    </div>
    <PlaygroundSection />
    <FeatureComparison />
    <div id="get-started">
        <GettingStarted />
    </div>
    <FooterSection />
</main>

@code {
    // Captures the optional language prefix (e.g. /fr). The request culture itself is
    // already resolved by the localization middleware; this only guards against arbitrary
    // single-segment paths so the one-page site doesn't render for /not-a-language.
    [Parameter] public string? Culture { get; set; }

    protected override void OnParametersSet()
    {
        if (Culture is not null && !SupportedCultures.IsSupported(Culture))
        {
            Nav.NavigateTo("/", replace: true);
        }
    }
}
