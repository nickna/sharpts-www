@inject IStringLocalizer<GettingStarted> L

<section class="section">
    <div class="container">
        <h2 class="section-title reveal">@L["Title"]</h2>
        <p class="section-subtitle reveal">@L["Subtitle"]</p>

        <div class="getting-started reveal">
            <div class="gs-step">
                <div class="gs-step__number">1</div>
                <div class="gs-step__content">
                    <h3 class="gs-step__title">@L["Step1_Title"]</h3>
                    <p class="gs-step__desc">@L["Step1_Desc"]</p>
                    <CodeBlock Title="@L["Terminal"]" Language="bash" Code="dotnet tool install -g SharpTS" />
                </div>
            </div>

            <div class="gs-step">
                <div class="gs-step__number">2</div>
                <div class="gs-step__content">
                    <h3 class="gs-step__title">@L["Step2_Title"]</h3>
                    <p class="gs-step__desc">@L["Step2_Desc"]</p>
                    <CodeBlock Title="hello.ts" Language="typescript" Code="@WriteCode" />
                </div>
            </div>

            <div class="gs-step">
                <div class="gs-step__number">3</div>
                <div class="gs-step__content">
                    <h3 class="gs-step__title">@L["Step3_Title"]</h3>
                    <p class="gs-step__desc">@L["Step3_Desc"]</p>
                    <CodeBlock Title="@L["Terminal"]" Language="bash" Code="@RunCode" />
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    // No prose/comments to translate — kept as a literal, identical across cultures.
    private const string WriteCode = """
        interface Config {
            name: string;
            debug: boolean;
        }

        const config: Config = { name: "MyApp", debug: true };
        console.log(`Starting ${config.name}...`);
        """;

    // Localized because the shell comments are translated.
    private string RunCode => L["RunCode"];
}
