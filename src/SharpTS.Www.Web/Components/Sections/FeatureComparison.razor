@inject IStringLocalizer<FeatureComparison> L

<section class="section" style="background: var(--bg-secondary);">
    <div class="container">
        <h2 class="section-title reveal">@L["Title"]</h2>
        <p class="section-subtitle reveal">@L["Subtitle"]</p>

        <div class="comparison reveal">
            @foreach (var group in _featureGroups)
            {
                <div class="comparison__group">
                    <h3 class="comparison__group-title">@group.Name</h3>
                    <table class="comparison__table">
                        <thead>
                            <tr>
                                <th>@L["Th_Feature"]</th>
                                <th>@L["Th_Status"]</th>
                                <th>@L["Th_Notes"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var feature in group.Features)
                            {
                                <tr>
                                    <td class="comparison__feature">@feature.Name</td>
                                    <td>
                                        @switch (feature.Status)
                                        {
                                            case Status.Done:
                                                <span class="badge badge-green">@L["Badge_Implemented"]</span>
                                                break;
                                            case Status.Partial:
                                                <span class="badge badge-yellow">@L["Badge_Partial"]</span>
                                                break;
                                            case Status.Missing:
                                                <span class="badge badge-red">@L["Badge_Missing"]</span>
                                                break;
                                        }
                                    </td>
                                    <td class="comparison__notes">@feature.Notes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum Status { Done, Partial, Missing }
    private record Feature(string Name, Status Status, string Notes = "");
    private record FeatureGroup(string Name, List<Feature> Features);

    private List<FeatureGroup> _featureGroups = [];

    protected override void OnInitialized()
    {
        _featureGroups =
        [
            new(L["Group_TypeSystem"], [
                new(L["Feat_PrimitiveTypes"], Status.Done),
                new(L["Feat_Generics"], Status.Done, L["Note_Generics"]),
                new(L["Feat_UnionIntersection"], Status.Done),
                new(L["Feat_LiteralTypes"], Status.Done),
                new(L["Feat_TupleTypes"], Status.Done, L["Note_TupleTypes"]),
                new(L["Feat_ConditionalTypes"], Status.Done, L["Note_ConditionalTypes"]),
                new(L["Feat_MappedTypes"], Status.Done, L["Note_MappedTypes"]),
                new(L["Feat_TemplateLiteralTypes"], Status.Done),
                new(L["Feat_UtilityTypes"], Status.Done, L["Note_UtilityTypes"])
            ]),
            new(L["Group_Classes"], [
                new(L["Feat_ClassesInheritance"], Status.Done),
                new(L["Feat_AccessModifiers"], Status.Done),
                new(L["Feat_AbstractClasses"], Status.Done),
                new(L["Feat_GettersSetters"], Status.Done),
                new(L["Feat_PrivateFields"], Status.Done),
                new(L["Feat_StaticBlocks"], Status.Done),
                new(L["Feat_Decorators"], Status.Done, L["Note_Decorators"]),
                new(L["Feat_MethodOverloading"], Status.Done)
            ]),
            new(L["Group_Functions"], [
                new(L["Feat_ArrowFunctions"], Status.Done),
                new(L["Feat_RestSpread"], Status.Done),
                new(L["Feat_Closures"], Status.Done),
                new(L["Feat_AsyncAwait"], Status.Done),
                new(L["Feat_PromiseCombinators"], Status.Done),
                new(L["Feat_Generators"], Status.Done),
                new(L["Feat_AsyncGenerators"], Status.Done),
                new(L["Feat_ForAwaitOf"], Status.Done)
            ]),
            new(L["Group_Modules"], [
                new(L["Feat_ImportExport"], Status.Done),
                new(L["Feat_DefaultExports"], Status.Done),
                new(L["Feat_NamespaceImports"], Status.Done),
                new(L["Feat_DynamicImports"], Status.Done),
                new(L["Feat_TypeScriptNamespaces"], Status.Done),
                new(L["Feat_ImportType"], Status.Done),
                new(L["Feat_ModuleAugmentation"], Status.Done)
            ]),
            new(L["Group_BuiltinApis"], [
                new(L["Feat_ConsoleLog"], Status.Done, L["Note_ConsoleLog"]),
                new(L["Feat_MathObject"], Status.Done),
                new(L["Feat_StringMethods"], Status.Done, L["Note_StringMethods"]),
                new(L["Feat_ArrayMethods"], Status.Done, L["Note_ArrayMethods"]),
                new(L["Feat_MapSet"], Status.Done, L["Note_MapSet"]),
                new(L["Feat_RegExp"], Status.Done),
                new(L["Feat_Date"], Status.Done),
                new(L["Feat_Json"], Status.Done),
                new(L["Feat_Promise"], Status.Done),
                new(L["Feat_Symbol"], Status.Done),
                new(L["Feat_Proxy"], Status.Missing),
                new(L["Feat_WeakRef"], Status.Missing)
            ]),
            new(L["Group_Advanced"], [
                new(L["Feat_UsingAwaitUsing"], Status.Done, L["Note_UsingAwaitUsing"]),
                new(L["Feat_SatisfiesOperator"], Status.Done),
                new(L["Feat_ConstTypeParameters"], Status.Done),
                new(L["Feat_BigintType"], Status.Done),
                new(L["Feat_TypedArrays"], Status.Done),
                new(L["Feat_SharedArrayBufferAtomics"], Status.Done)
            ])
        ];
    }
}
