@using System.Globalization
@* Compact teaser for the home page. Reuses the ArchitectureDiagram resource strings so the
   stage labels stay in sync and already-translated. The full, interactive walkthrough lives
   on the dedicated /how-it-works page that the CTA links to. *@
@inject IStringLocalizer<ArchitectureDiagram> L

<section class="section section--alt">
    <div class="container">
        <h2 class="section-title reveal">@L["Title"]</h2>
        <p class="section-subtitle reveal">@L["Subtitle"]</p>

        <div class="arch-preview reveal">
            <div class="arch-preview__flow">
                <span class="arch-preview__node">@L["Label_Source"]</span>
                <span class="arch-preview__sep" aria-hidden="true">→</span>
                <span class="arch-preview__node">@L["Label_Lexer"]</span>
                <span class="arch-preview__sep" aria-hidden="true">→</span>
                <span class="arch-preview__node">@L["Label_Parser"]</span>
                <span class="arch-preview__sep" aria-hidden="true">→</span>
                <span class="arch-preview__node arch-preview__node--accent">@L["Label_TypeChecker"]</span>
                <span class="arch-preview__sep" aria-hidden="true">→</span>
                <span class="arch-preview__node arch-preview__node--interpret">@L["Label_Interpreter"]</span>
                <span class="arch-preview__sep arch-preview__sep--or" aria-hidden="true">/</span>
                <span class="arch-preview__node arch-preview__node--compile">@L["Label_ILCompiler"]</span>
            </div>

            <a href="@Href" class="btn btn-primary arch-preview__cta">
                @L["Cta_LearnMore"]
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </a>
        </div>
    </div>
</section>

@code {
    // Culture-correct path to the guide: English at the bare path, others under their prefix
    // (mirrors the routing in HowItWorks.razor / NavHeader).
    private static string Href
    {
        get
        {
            var culture = SupportedCultures.Normalize(CultureInfo.CurrentCulture.Name) ?? SupportedCultures.Default;
            return culture == SupportedCultures.Default ? "/how-it-works" : $"/{culture}/how-it-works";
        }
    }
}
