@using System.Globalization
@inject IJSRuntime JS
@inject IStringLocalizer<NavHeader> L
@implements IDisposable

<header class="nav @(_scrolled ? "nav--scrolled" : "")" @ref="_headerEl">
    <div class="container nav__inner">
        <a href="#" class="nav__logo" @onclick="ScrollToTop" @onclick:preventDefault>
            <img src="img/sharpts-logo.png" alt="SharpTS logo" class="nav__logo-icon" width="32" height="32" />
            <span class="nav__logo-text">SharpTS</span>
        </a>

        <nav class="nav__links @(_menuOpen ? "nav__links--open" : "")">
            @* Section anchors are home-prefixed so they also work from the /how-it-works page —
               from there they navigate back home and scroll. "How It Works" is now a real page. *@
            <a href="@($"{Home}#features")" class="nav__link" @onclick="CloseMenu">@L["Nav_Features"]</a>
            <a href="@($"{Home}#examples")" class="nav__link" @onclick="CloseMenu">@L["Nav_Examples"]</a>
            <a href="@HowItWorksHref" class="nav__link" @onclick="CloseMenu">@L["Nav_HowItWorks"]</a>
            <a href="@($"{Home}#playground")" class="nav__link" @onclick="CloseMenu">@L["Nav_Playground"]</a>
            <a href="@($"{Home}#get-started")" class="nav__link" @onclick="CloseMenu">@L["Nav_GetStarted"]</a>
            <a href="https://github.com/nickna/SharpTS" target="_blank" rel="noopener" class="nav__link nav__link--github">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
            </a>
            <LanguageSelector />
        </nav>

        <button class="nav__hamburger @(_menuOpen ? "nav__hamburger--open" : "")"
                @onclick="ToggleMenu" aria-label="@L["Nav_ToggleAriaLabel"]">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
</header>

@code {
    // Build culture-correct links. English lives at the bare path; other cultures under a
    // /{culture} prefix (mirrors HowItWorks.razor routing and the language middleware).
    private static string Culture =>
        SupportedCultures.Normalize(CultureInfo.CurrentCulture.Name) ?? SupportedCultures.Default;

    private static string Home => Culture == SupportedCultures.Default ? "/" : $"/{Culture}";

    private static string HowItWorksHref =>
        Culture == SupportedCultures.Default ? "/how-it-works" : $"/{Culture}/how-it-works";

    private bool _scrolled;
    private bool _menuOpen;
    private ElementReference _headerEl;
    private DotNetObjectReference<NavHeader>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initNavScroll", _dotNetRef);
        }
    }

    [JSInvokable]
    public void OnScrollStateChanged(bool scrolled)
    {
        if (_scrolled != scrolled)
        {
            _scrolled = scrolled;
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task ScrollToTop()
    {
        await JS.InvokeVoidAsync("scrollToTop");
        _menuOpen = false;
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    public void Dispose() => _dotNetRef?.Dispose();
}
