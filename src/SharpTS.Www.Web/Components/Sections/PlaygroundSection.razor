@inject PlaygroundApiClient Api
@inject IJSRuntime JS
@inject IStringLocalizer<PlaygroundSection> L

<section class="section" id="playground">
    <div class="container">
        <h2 class="section-title reveal">@L["Title"]</h2>
        <p class="section-subtitle reveal">@L["Subtitle"]</p>

        <div class="playground reveal">
            <div class="playground__toolbar">
                <div class="playground__toolbar-left">
                    <select class="playground__preset" @onchange="OnPresetChanged">
                        <option value="">@L["SelectPreset"]</option>
                        @foreach (var preset in _presets)
                        {
                            <option value="@preset.Name">@preset.Name</option>
                        }
                    </select>
                    <div class="playground__mode" role="group" aria-label="@L["ModeLabel"]">
                        <button class="playground__mode-btn @(_mode == "interpret" ? "playground__mode-btn--active" : "")"
                                @onclick="@(() => _mode = "interpret")">@L["ModeInterpret"]</button>
                        <button class="playground__mode-btn @(_mode == "compile" ? "playground__mode-btn--active" : "")"
                                @onclick="@(() => _mode = "compile")">@L["ModeCompile"]</button>
                    </div>
                </div>
                <div class="playground__toolbar-right">
                    <button class="btn btn-sm btn-secondary" @onclick="ClearOutput">@L["Clear"]</button>
                    <button id="playground-run-btn"
                            class="btn btn-sm btn-primary"
                            @onclick="RunCode"
                            disabled="@_running">
                        @if (_running)
                        {
                            <span class="playground__spinner"></span>
                            <span>@L["Running"]</span>
                        }
                        else
                        {
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                <polygon points="5 3 19 12 5 21 5 3"></polygon>
                            </svg>
                            <span>@L["Run"]</span>
                            <kbd class="playground__kbd">@L["RunShortcut"]</kbd>
                        }
                    </button>
                </div>
            </div>

            <div class="playground__body">
                <div class="playground__editor">
                    <div id="playground-editor" class="playground__cm-container"></div>
                </div>
                <div class="playground__output">
                    <div class="playground__output-header">
                        <span>@L["Output"]</span>
                        @if (_executionTime.HasValue)
                        {
                            <span class="playground__timing">
                                @(_compileTime.HasValue
                                    ? string.Format(L["TimingCompiled"], _compileTime, _executionTime)
                                    : $"{_executionTime}ms")
                            </span>
                        }
                    </div>
                    <div class="playground__output-body">
                        @if (!string.IsNullOrEmpty(_output))
                        {
                            <pre class="playground__stdout">@_output</pre>
                        }
                        @if (_errors.Count > 0)
                        {
                            <div class="playground__errors">
                                @foreach (var error in _errors)
                                {
                                    <div class="playground__error">@error.Message</div>
                                }
                            </div>
                        }
                        @if (string.IsNullOrEmpty(_output) && _errors.Count == 0 && !_running)
                        {
                            <span class="playground__placeholder">@L["Placeholder"]</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private List<PresetExample> _presets = [];
    private bool _running;
    private string _output = "";
    private List<ErrorInfo> _errors = [];
    private long? _executionTime;
    private long? _compileTime;
    private string _mode = "interpret";
    private bool _editorReady;

    private string DefaultCode => L["DefaultCode"];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _presets = await Api.GetPresetsAsync();
                StateHasChanged();
            }
            catch
            {
                // API not available yet, use empty presets
            }

            try
            {
                _editorReady = await JS.InvokeAsync<bool>("createCodeMirror", "playground-editor", DefaultCode);
            }
            catch
            {
                // CodeMirror ESM imports may fail; playground will be non-functional but page stays interactive
            }
        }
    }

    private async Task RunCode()
    {
        if (_running || !_editorReady) return;

        _running = true;
        _output = "";
        _errors = [];
        _executionTime = null;
        _compileTime = null;
        StateHasChanged();

        try
        {
            var source = await JS.InvokeAsync<string>("getCodeMirrorValue", "playground-editor");
            var response = await Api.RunAsync(source, mode: _mode);

            if (response is not null)
            {
                _output = response.Output;
                _errors = response.Errors;
                _executionTime = response.ExecutionTimeMs;
                _compileTime = response.CompileTimeMs;
            }
        }
        catch (Exception ex)
        {
            _errors = [new ErrorInfo(ex.Message, null, null)];
        }
        finally
        {
            _running = false;
        }
    }

    private void ClearOutput()
    {
        _output = "";
        _errors = [];
        _executionTime = null;
        _compileTime = null;
    }

    private async Task OnPresetChanged(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();
        if (string.IsNullOrEmpty(name)) return;

        var preset = _presets.FirstOrDefault(p => p.Name == name);
        if (preset is not null && _editorReady)
        {
            await JS.InvokeVoidAsync("setCodeMirrorValue", "playground-editor", preset.Source);
            ClearOutput();
        }
    }
}
