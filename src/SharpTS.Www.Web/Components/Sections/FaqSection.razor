@inject IStringLocalizer<FaqSection> L

<section class="section">
    <div class="container">
        <h2 class="section-title reveal">@L["Title"]</h2>
        <p class="section-subtitle reveal">@L["Subtitle"]</p>

        <div class="faq reveal">
            @foreach (var item in _items)
            {
                <details class="card faq__item">
                    <summary class="faq__question">
                        <span>@item.Question</span>
                        <span class="faq__chevron" aria-hidden="true">▾</span>
                    </summary>
                    <div class="faq__answer">
                        <p>@item.Answer</p>
                        @if (item.LinkHref is not null)
                        {
                            <a href="@item.LinkHref" target="_blank" rel="noopener">@item.LinkLabel</a>
                        }
                    </div>
                </details>
            }
        </div>
    </div>
</section>

@code {
    private record FaqItem(string Question, string Answer, string? LinkHref = null, string? LinkLabel = null);

    private List<FaqItem> _items = [];

    // Localized lists are built here (not in field initializers) because the injected
    // IStringLocalizer isn't available until the component is initialized.
    protected override void OnInitialized()
    {
        _items =
        [
            new(L["Q1"], L["A1"]),
            new(L["Q2"], L["A2"]),
            new(L["Q3"], L["A3"], "https://github.com/nickna/SharpTS/blob/main/STATUS-NODE.md", L["Link_NodeStatus"]),
            new(L["Q4"], L["A4"]),
            new(L["Q5"], L["A5"], "https://github.com/nickna/SharpTS/blob/main/STATUS.md", L["Link_Status"]),
        ];
    }
}
