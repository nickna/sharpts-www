@inject IStringLocalizer<ArchitectureDiagram> L

<section class="section">
    <div class="container">
        <h2 class="section-title reveal">@L["Title"]</h2>
        <p class="section-subtitle reveal">@L["Subtitle"]</p>

        <div class="architecture reveal">
            <div class="pipeline">
                <div class="pipeline__step">
                    <div class="pipeline__box pipeline__box--input">
                        <span class="pipeline__icon">📄</span>
                        <span class="pipeline__label">@L["Label_Source"]</span>
                    </div>
                    <div class="pipeline__arrow"></div>
                </div>

                <div class="pipeline__step">
                    <button type="button" class="pipeline__box @SelectedClass("Lexer")"
                            @onclick='() => Toggle("Lexer")' aria-pressed="@IsSelected("Lexer")">
                        <span class="pipeline__icon">🔤</span>
                        <span class="pipeline__label">@L["Label_Lexer"]</span>
                        <span class="pipeline__detail">@L["Detail_Lexer"]</span>
                    </button>
                    <div class="pipeline__arrow"></div>
                </div>

                <div class="pipeline__step">
                    <button type="button" class="pipeline__box @SelectedClass("Parser")"
                            @onclick='() => Toggle("Parser")' aria-pressed="@IsSelected("Parser")">
                        <span class="pipeline__icon">🌳</span>
                        <span class="pipeline__label">@L["Label_Parser"]</span>
                        <span class="pipeline__detail">@L["Detail_Parser"]</span>
                    </button>
                    <div class="pipeline__arrow"></div>
                </div>

                <div class="pipeline__step">
                    <button type="button" class="pipeline__box pipeline__box--accent @SelectedClass("TypeChecker")"
                            @onclick='() => Toggle("TypeChecker")' aria-pressed="@IsSelected("TypeChecker")">
                        <span class="pipeline__icon">🔍</span>
                        <span class="pipeline__label">@L["Label_TypeChecker"]</span>
                        <span class="pipeline__detail">@L["Detail_TypeChecker"]</span>
                    </button>
                    <div class="pipeline__arrow pipeline__arrow--fork"></div>
                </div>
            </div>

            <div class="pipeline__branches">
                <div class="pipeline__branch">
                    <div class="pipeline__branch-arrow pipeline__branch-arrow--top"></div>
                    <button type="button" class="pipeline__box pipeline__box--interpret @SelectedClass("Interpreter")"
                            @onclick='() => Toggle("Interpreter")' aria-pressed="@IsSelected("Interpreter")">
                        <span class="pipeline__icon">▶️</span>
                        <span class="pipeline__label">@L["Label_Interpreter"]</span>
                        <span class="pipeline__detail">@L["Detail_Interpreter"]</span>
                    </button>
                    <div class="pipeline__arrow"></div>
                    <div class="pipeline__box pipeline__box--output">
                        <span class="pipeline__label">@L["Label_Output"]</span>
                    </div>
                </div>

                <div class="pipeline__branch">
                    <div class="pipeline__branch-arrow pipeline__branch-arrow--bottom"></div>
                    <button type="button" class="pipeline__box pipeline__box--compile @SelectedClass("ILCompiler")"
                            @onclick='() => Toggle("ILCompiler")' aria-pressed="@IsSelected("ILCompiler")">
                        <span class="pipeline__icon">⚙️</span>
                        <span class="pipeline__label">@L["Label_ILCompiler"]</span>
                        <span class="pipeline__detail">@L["Detail_ILCompiler"]</span>
                    </button>
                    <div class="pipeline__arrow"></div>
                    <div class="pipeline__box pipeline__box--output">
                        <span class="pipeline__label">@L["Label_DotNetAssembly"]</span>
                    </div>
                </div>
            </div>

            @* Detail panel is always present (so selecting a stage causes no layout shift) and
               updates in place when a stage button is pressed. aria-live announces the change
               to assistive tech. This is user-triggered, not an entrance effect, so the fade
               transition is safe under prerender. *@
            <div class="pipeline__detail-panel" role="region" aria-live="polite">
                @if (_selected is null)
                {
                    <p class="pipeline__detail-hint">@L["SelectHint"]</p>
                }
                else
                {
                    <h3 class="pipeline__detail-title">@L[$"Label_{_selected}"]</h3>
                    <p class="pipeline__detail-body">@L[$"Explain_{_selected}"]</p>
                }
            </div>
        </div>
    </div>
</section>

@code {
    // PascalCase suffix of the selected stage's resx keys (e.g. "Lexer" → Label_Lexer /
    // Explain_Lexer), or null when nothing is selected. Clicking the active stage clears it.
    private string? _selected;

    private void Toggle(string stage) => _selected = _selected == stage ? null : stage;

    private bool IsSelected(string stage) => _selected == stage;

    private string SelectedClass(string stage) => _selected == stage ? "pipeline__box--selected" : "";
}
