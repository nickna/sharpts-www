<section class="section">
    <div class="container">
        <h2 class="section-title reveal">What SharpTS Does</h2>
        <p class="section-subtitle reveal">A complete TypeScript runtime and compiler built entirely in C#</p>

        <div class="features-grid">
            <div class="card feature-card reveal">
                <div class="feature-card__icon" style="color: var(--accent-green);">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="4 17 10 11 4 5"></polyline>
                        <line x1="12" y1="19" x2="20" y2="19"></line>
                    </svg>
                </div>
                <h3 class="feature-card__title">Interpret</h3>
                <p class="feature-card__desc">Tree-walking execution with instant startup. Perfect for scripting, REPL sessions, and rapid prototyping.</p>
            </div>

            <div class="card feature-card reveal">
                <div class="feature-card__icon" style="color: var(--accent-csharp);">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                        <path d="M2 17l10 5 10-5"></path>
                        <path d="M2 12l10 5 10-5"></path>
                    </svg>
                </div>
                <h3 class="feature-card__title">Compile</h3>
                <p class="feature-card__desc">AOT compilation to standalone .NET assemblies. Ship native binaries with full .NET performance.</p>
            </div>

            <div class="card feature-card reveal">
                <div class="feature-card__icon" style="color: var(--accent-neon);">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                </div>
                <h3 class="feature-card__title">.NET Interop</h3>
                <p class="feature-card__desc">Access .NET BCL types directly via <code>@@DotNetType</code> decorators. Bridge TypeScript and C# seamlessly.</p>
            </div>

            <div class="card feature-card reveal">
                <div class="feature-card__icon" style="color: var(--accent-ts);">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="16 18 22 12 16 6"></polyline>
                        <polyline points="8 6 2 12 8 18"></polyline>
                    </svg>
                </div>
                <h3 class="feature-card__title">Full TypeScript</h3>
                <p class="feature-card__desc">Types, generics, classes, interfaces, modules, decorators, mapped types, conditional types, and more.</p>
            </div>

            <div class="card feature-card reveal">
                <div class="feature-card__icon" style="color: var(--accent-yellow);">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </div>
                <h3 class="feature-card__title">Async & Generators</h3>
                <p class="feature-card__desc">Full async/await support, Promise combinators, generator functions, and async iterators.</p>
            </div>

            <div class="card feature-card reveal">
                <div class="feature-card__icon" style="color: var(--accent-green);">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                </div>
                <h3 class="feature-card__title">Module System</h3>
                <p class="feature-card__desc">ES6 imports/exports, namespaces, dynamic imports, re-exports, and CommonJS interop.</p>
            </div>
        </div>
    </div>
</section>
