@inject IJSRuntime JS
@inject IStringLocalizer<LiveCodeExamples> L

<section class="section" style="background: var(--bg-secondary);">
    <div class="container">
        <h2 class="section-title reveal">@L["Title"]</h2>
        <p class="section-subtitle reveal">@L["Subtitle"]</p>

        <div class="examples reveal" @ref="_element">
            <div class="tabs">
                @foreach (var example in _examples)
                {
                    <button class="tab @(example == _active ? "active" : "")"
                            @onclick="() => SetActive(example)">
                        @example.Title
                    </button>
                }
            </div>
            <div class="examples__body" @key="_active">
                <div class="examples__code">
                    <div class="code-block__content">
                        <pre><code class="language-typescript">@_active.Code</code></pre>
                    </div>
                </div>
                <div class="examples__output">
                    <div class="code-block__header">
                        <span>@L["Output"]</span>
                    </div>
                    <div class="code-block__content">
                        <pre class="examples__output-text">@_active.Output</pre>
                    </div>
                </div>
            </div>
        </div>

        <p class="examples__cta reveal">
            <a href="#playground">@L["Cta_TryYourOwn"]</a>
        </p>
    </div>
</section>

@code {
    private ElementReference _element;
    private Example _active = null!;

    private record Example(string Title, string Code, string Output);

    // Titles and code (including their comments) are localized; program Output is the
    // interpreter's literal stdout and stays identical across languages.
    private List<Example> _examples = [];

    private bool _highlightPending;

    protected override void OnInitialized()
    {
        _examples =
        [
            new(L["Ex1_Title"], L["Ex1_Code"],
                """
                Hello from SharpTS! v1
                  ✓ TypeScript
                  ✓ C#
                  ✓ .NET
                """),

            new(L["Ex2_Title"], L["Ex2_Code"],
                """
                0°C (32°F)
                37°C (98.6°F)
                100°C (212°F)
                """),

            new(L["Ex3_Title"], L["Ex3_Code"],
                """
                Done after 100ms
                Done after 50ms
                Done after 100ms
                Done after 150ms
                """),

            new(L["Ex4_Title"], L["Ex4_Code"],
                """
                Sum of squares of evens: 220
                First: 1, Second: 2
                Rest: [3, 4, 5, 6, 7, 8, 9, 10]
                """),

            new(L["Ex5_Title"], L["Ex5_Code"],
                """
                PI = 3.141592653589793
                E  = 2.718281828459045
                sqrt(144) = 12
                ISO: 2026-03-02T12:00:00.000Z
                JSON: {"name":"SharpTS","nums":[1,2,3]}
                """),

            new(L["Ex6_Title"], L["Ex6_Code"],
                """
                1.5 hours = 90 minutes
                """)
        ];

        _active = _examples[0];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Highlight on first render and after every tab switch. Running here —
        // rather than after a guessed Task.Delay — guarantees the new tab's DOM
        // is committed before Prism runs over it.
        if (firstRender || _highlightPending)
        {
            _highlightPending = false;
            await JS.InvokeVoidAsync("highlightCode", _element);
        }
    }

    private void SetActive(Example example)
    {
        _active = example;
        _highlightPending = true;
        // The click handler's automatic re-render triggers OnAfterRenderAsync,
        // which performs the highlight once the new DOM is in place.
    }
}
