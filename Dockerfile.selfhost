# syntax=docker/dockerfile:1
FROM node:25-bookworm-slim AS browser-build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci
COPY scripts/build-browser.mjs scripts/build-browser.mjs
COPY src/SharpTS.Www.SelfHost/browser/ src/SharpTS.Www.SelfHost/browser/
COPY src/SharpTS.Www.Shared/ src/SharpTS.Www.Shared/
RUN SHARPTS_WWW_BROWSER_OUTPUT=/browser-assets npm run build:browser

FROM node:25-bookworm-slim AS api-reference-build
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
COPY tools/api-docs/package.json tools/api-docs/package-lock.json tools/api-docs/
RUN npm ci --prefix tools/api-docs
COPY tools/api-docs/generate-api-reference.mjs tools/api-docs/ambient.d.ts tools/api-docs/tsconfig.json tools/api-docs/
COPY sharpts-source.env ./
# API extraction and the compiled runtime use the same exact pinned SharpTS revision.
RUN set -eu; \
    . ./sharpts-source.env; \
    SHARPTS_SOURCE_REVISION="$(printf '%s' "$SHARPTS_SOURCE_REVISION" | tr -d '\r')"; \
    git init lib/SharpTS; \
    git -C lib/SharpTS remote add origin https://github.com/nickna/SharpTS.git; \
    git -C lib/SharpTS fetch --depth 1 origin "$SHARPTS_SOURCE_REVISION"; \
    git -C lib/SharpTS checkout --detach FETCH_HEAD; \
    test "$(git -C lib/SharpTS rev-parse HEAD)" = "$SHARPTS_SOURCE_REVISION"; \
    node tools/api-docs/generate-api-reference.mjs

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY . .
COPY --from=browser-build /browser-assets /browser-assets
COPY --from=api-reference-build /src/lib/SharpTS /src/lib/SharpTS
COPY --from=api-reference-build /src/sharpts-source.env /src/sharpts-source.env
COPY --from=api-reference-build /src/artifacts/api-reference/catalog.json /src/artifacts/api-reference/catalog.json

RUN set -eu; \
    . ./sharpts-source.env; \
    SHARPTS_SOURCE_REVISION="$(printf '%s' "$SHARPTS_SOURCE_REVISION" | tr -d '\r')"; \
    if ! dotnet build lib/SharpTS/SharpTS.csproj -c Release --nologo \
        -p:MinVerVersionOverride="0.0.0-main+$SHARPTS_SOURCE_REVISION" \
        -p:SourceRevisionId="$SHARPTS_SOURCE_REVISION" \
        -p:EnableSourceLink=false \
        -p:EnableSourceControlManagerQueries=false \
        -p:PublishRepositoryUrl=false > /tmp/sharpts-build.log 2>&1; then \
      cat /tmp/sharpts-build.log; \
      exit 1; \
    fi; \
    cat /tmp/sharpts-build.log; \
    test -f lib/SharpTS/bin/Release/net10.0/SharpTS.dll

RUN set -eu; \
    mkdir -p /app; \
    if ! dotnet lib/SharpTS/bin/Release/net10.0/SharpTS.dll \
        --compile src/SharpTS.Www.SelfHost/server.ts \
        --verify \
        -o /app/SharpTS.Www.SelfHost.dll > /tmp/sharpts-compile.log 2>&1; then \
      cat /tmp/sharpts-compile.log; \
      exit 1; \
    fi; \
    cat /tmp/sharpts-compile.log; \
    grep -q "Compiled to" /tmp/sharpts-compile.log; \
    grep -q "IL verification passed." /tmp/sharpts-compile.log; \
    test -f /app/SharpTS.Www.SelfHost.dll
RUN set -eu; \
    mkdir -p /app/worker; \
    if ! dotnet lib/SharpTS/bin/Release/net10.0/SharpTS.dll \
        --compile src/SharpTS.Www.Worker/worker.ts \
        --target exe \
        --verify \
        -o /app/worker/SharpTS.Www.Worker > /tmp/worker-compile.log 2>&1; then \
      cat /tmp/worker-compile.log; \
      exit 1; \
    fi; \
    cat /tmp/worker-compile.log; \
    grep -q "Compiled to" /tmp/worker-compile.log; \
    grep -q "IL verification passed." /tmp/worker-compile.log; \
    test -f /app/worker/SharpTS.Www.Worker; \
    test -f /app/worker/SharpTS.dll
# Route cardinality is enforced by scripts/test-generated-site.ps1.
RUN set -eu; \
    mkdir -p /app/public; \
    if ! SHARPTS_WWW_SITE_REPO_ROOT=/src \
        SHARPTS_WWW_SITE_OUTPUT=/app/public \
        SHARPTS_WWW_BROWSER_OUTPUT=/browser-assets \
        dotnet lib/SharpTS/bin/Release/net10.0/SharpTS.dll \
        src/SharpTS.Www.SelfHost/generate-site.ts > /tmp/site-generation.log 2>&1; then \
      cat /tmp/site-generation.log; \
      exit 1; \
    fi; \
    cat /tmp/site-generation.log; \
    grep -Fq "Generated localized static site" /tmp/site-generation.log; \
    test -f /app/public/conformance.json; \
    test -f /app/public/site-manifest.json; \
    test -f /app/public/setup.ps1; \
    cp sharpts-source.env /app/sharpts-source.env

FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /app

LABEL org.opencontainers.image.source="https://github.com/nickna/sharpts-www" \
      org.opencontainers.image.licenses="MIT" \
      io.sharpts.runtime.source="https://github.com/nickna/SharpTS"

COPY --from=build /app/ ./

ENV SHARPTS_WWW_HOST=0.0.0.0
ENV SHARPTS_WWW_WORKER_PATH=/app/worker/SharpTS.Www.Worker
ENV SHARPTS_WWW_REQUIRE_RSS_MONITORING=true

EXPOSE 8080

# Both the host and every untrusted playground worker run without root.
USER $APP_UID

ENTRYPOINT ["dotnet", "SharpTS.Www.SelfHost.dll"]
