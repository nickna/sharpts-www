{
  "name": "sharpts-www-browser",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:browser": "node scripts/build-browser.mjs",
    "test:browser": "vitest run",
    "test:browser-bundle": "node scripts/test-browser-bundle.mjs",
    "test:e2e": "playwright test",
    "typecheck:browser": "tsc --noEmit -p src/SharpTS.Www.SelfHost/browser/tsconfig.json",
    "verify:browser": "npm run typecheck:browser && npm run test:browser && npm run test:browser-bundle"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/state": "6.7.1",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.8",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "codemirror": "6.0.2",
    "prismjs": "1.30.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "@types/prismjs": "1.26.6",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
