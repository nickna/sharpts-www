{
  "name": "sharpts-www-browser",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run verify:browser",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "typecheck": "npm run typecheck:browser",
    "verify:source": "node scripts/verify-sharpts-source.mjs",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "check:i18n": "vitest run --project unit tests/unit/i18n.test.ts",
    "generate:api": "npm ci --prefix tools/api-docs && npm run generate --prefix tools/api-docs",
    "test:api-docs": "npm test --prefix tools/api-docs",
    "build:browser": "node scripts/build-browser.mjs",
    "build:self-host": "node scripts/build-self-host.mjs",
    "check:browser-budget": "node scripts/check-browser-budget.mjs",
    "test:browser": "vitest run",
    "test:browser-bundle": "node scripts/test-browser-bundle.mjs",
    "test:e2e": "playwright test",
    "test:generated": "pwsh -File scripts/test-generated-site.ps1",
    "test:apphost-manifest": "pwsh -File scripts/test-apphost-manifest.ps1",
    "test:setup:powershell": "pwsh -File scripts/test-setup.ps1",
    "test:benchmark-refresh": "pwsh -NoProfile -File scripts/test-refresh-performance-benchmarks.ps1",
    "test:isolation": "pwsh -File scripts/test-self-host-container.ps1",
    "snapshot:update": "node scripts/update-site-snapshot.mjs --accept",
    "typecheck:browser": "tsc --noEmit -p src/SharpTS.Www.SelfHost/browser/tsconfig.json",
    "verify:browser": "npm run generate:api && npm run typecheck:browser && npm run test:browser && npm run build:browser && npm run check:browser-budget && npm run test:browser-bundle",
    "verify": "npm run verify:source && npm run check:secrets && npm run test:benchmark-refresh && npm run check:i18n && npm run check && npm run verify:browser"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.9",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "codemirror": "6.0.2",
    "prismjs": "1.30.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/prismjs": "1.26.6",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
