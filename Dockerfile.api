# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY . .

# .git is excluded by .dockerignore so submodule won't be populated; clone it directly
RUN if [ ! -f lib/SharpTS/SharpTS.csproj ]; then \
      rm -rf lib/SharpTS && \
      git clone --depth 1 https://github.com/nickna/SharpTS.git lib/SharpTS; \
    fi

RUN dotnet restore src/SharpTS.Www.Api/SharpTS.Www.Api.csproj
RUN dotnet restore src/SharpTS.Www.Worker/SharpTS.Www.Worker.csproj

RUN dotnet publish src/SharpTS.Www.Api/SharpTS.Www.Api.csproj -c Release -o /app/api --no-restore
RUN dotnet publish src/SharpTS.Www.Worker/SharpTS.Www.Worker.csproj -c Release -o /app/worker --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

COPY --from=build /app/api ./api/
COPY --from=build /app/worker ./worker/

ENV ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
ENV Worker__ExecutablePath=/app/worker/SharpTS.Www.Worker

EXPOSE 8080

# Run as the image's built-in non-root user. The API executes untrusted
# playground code in the worker it spawns; the child inherits this UID, so
# guest code runs unprivileged. Defense-in-depth for the file system: even if
# a read/write path ever became reachable from playground TypeScript (today
# none is — fs/require need module resolution, which single-source mode
# rejects), an unprivileged process cannot reach root-owned secrets or config.
# Pairs with the env-clearing in TypeScriptExecutionService and the network
# egress block in the worker. For a stronger boundary, also configure a
# read-only root filesystem at the Railway service level.
USER $APP_UID

ENTRYPOINT ["dotnet", "api/SharpTS.Www.Api.dll"]
